      "position": [
        260,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "configure-after-import",
          "name": "Sales backend API"
        }
      }
    },
    {
      "id": "f266d756-df2a-5ad6-8414-cc2dc3770927",
      "name": "Return task receipt",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 202
        }
      },
      "position": [
        520,
        0
      ]
    }
  ],
  "connections": {

# Create a private local .env with: python scripts/bootstrap.py
SALES_API_KEY=replace-with-a-long-random-value
SALES_DATA_DIR=./data
SALES_OLLAMA_URL=http://127.0.0.1:11434
SALES_LLM_MODEL=qwen3:8b
SALES_EMBEDDING_MODEL=nomic-embed-text
SALES_USE_LLM=false
SALES_MAX_UPLOAD_MB=25
SALES_MAX_ROWS=200000
SALES_MAX_COLUMNS=200
SALES_WORKERS=1
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
OLLAMA_NO_CLOUD=1
